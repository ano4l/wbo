# WE BUILD ONCE - production SPA routing
# Allows direct loading of /about, /services, /leadership, /projects, /contact, etc.
RewriteEngine On

# Do not rewrite real files or directories.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Send application routes to the SPA entry point.
RewriteRule ^ index.html [L]
